{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run verify:artifacts",
    "beforeBundleCommand": {
      "script": "python ../../scripts/desktop_release.py verify-tree --tree release/backend",
      "cwd": "."
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "release/backend/": "backend/",
      "../../gallery-dl-backend/gdl_backend/webui_dist/frontend-manifest.json": "frontend-manifest.json"
    }
  }
}
