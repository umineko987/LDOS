{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "types": ["$app/types", "vite/client", "node"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "scripts/*.ts", "vite.config.ts", "vite.legacy.config.ts"],
  "exclude": ["src/service-worker"]
}
