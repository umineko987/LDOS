{
  "name": "ldos-desktop",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "npm run build:legacy && vite dev",
    "build": "npm run build:legacy && vite build && node scripts/externalize-boot.mjs && node scripts/frontend-manifest.mjs",
    "build:legacy": "vite build -c vite.legacy.config.ts",
    "preview": "vite preview",
    "sync": "svelte-kit sync",
    "check": "npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p e2e/tsconfig.json && npm run check:legacy",
    "check:legacy": "svelte-check --tsconfig ./legacy-src/tsconfig.json",
    "i18n": "paraglide-js compile --project ./project.inlang --silent",
    "test": "npm run i18n && vitest run --coverage && npm run test:legacy",
    "test:coverage": "npm run i18n && vitest run --coverage",
    "test:legacy": "vitest run -c vite.legacy.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "tauri": "tauri",
    "api:gen": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@inlang/paraglide-js": "2.29.3",
    "@inlang/plugin-message-format": "4.5.5",
    "@internationalized/date": "3.12.0",
    "@lucide/svelte": "1.63.0",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/mcp": "0.1.26",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/svelte-query": "6.3.6",
    "@tanstack/virtual-core": "3.19.8",
    "@tauri-apps/cli": "2.11.4",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "bits-ui": "2.20.0",
    "cn": "0.3.3",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "paneforge": "1.0.2",
    "shadcn-svelte": "1.7.0",
    "svelte-check": "4.7.7",
    "svelte-sonner": "1.2.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
