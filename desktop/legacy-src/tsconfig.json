{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "paths": { "$lib/*": ["./lib/*"] },
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["svelte", "vite/client", "node"],
    "allowArbitraryExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["./**/*.ts", "./**/*.svelte"]
}
